# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- PostgreSQL ---
POSTGRES_DB=gameradar
POSTGRES_USER=gameradar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# --- Запуск без Docker (локальный PostgreSQL и Memurai/Redis) ---
# В Docker эти две строки не используются: адреса задаёт docker-compose.yml.
DATABASE_URL=postgres://gameradar:change-me@localhost:5432/gameradar?sslmode=disable
REDIS_URL=redis://localhost:6379

# --- Redis ---
REDIS_HOST_PORT=6379

# --- Сервер ---
SERVER_HOST_PORT=8080
# Секрет для подписи JWT анонимных пользователей (минимум 32 случайных символа).
JWT_SECRET=change-me-to-a-long-random-string

# --- Steam (только сервер и worker, никогда не в приложении) ---
STEAM_API_KEY=
# Регион и валюта по умолчанию.
DEFAULT_REGION=kz
# Режим распродажи: цены обновляются раз в час вместо 2–6 часов.
SALE_MODE=false

# --- Firebase Cloud Messaging (HTTP v1) ---
FCM_PROJECT_ID=
# JSON-ключ сервисного аккаунта Firebase (Настройки проекта → Сервисные аккаунты).
# В Docker папка ./secrets монтируется в /run/secrets; без Docker укажите путь
# на диске, например C:/Users/Admin/Desktop/GameRadar/secrets/fcm-service-account.json
# Пока FCM_PROJECT_ID пуст, worker только пишет уведомления в журнал.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json

# Исторические минимумы цен в Steam (IsThereAnyDeal, история с 2013 года).
# Ключ: https://isthereanydeal.com/apps/my/ (бесплатно). Без ключа выключено.
ITAD_API_KEY=

# Регионы для сравнения цен (сверх основного), через запятую. Пусто — выключено.
# Курсы для пересчёта в тенге — Национальный банк Казахстана (без ключа).
COMPARE_REGIONS=us,de,tr,ar,ru,in
